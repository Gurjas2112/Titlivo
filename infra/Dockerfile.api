# Production API image (no web app). Built and pushed by scripts/deploy.sh to Lightsail.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /usr/local/bin/uv
WORKDIR /app
COPY api/pyproject.toml api/uv.lock api/README.md api/
RUN uv sync --directory api --frozen --no-dev --no-install-project
COPY api/src api/src
COPY config config
COPY supabase/migrations supabase/migrations
RUN uv sync --directory api --frozen --no-dev && useradd --uid 10001 --no-create-home titlivo
USER titlivo
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz')"
CMD ["/app/api/.venv/bin/uvicorn", "titlivo.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*", "--timeout-graceful-shutdown", "20"]
