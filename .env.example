# Copy to .env (git-ignored), then run `make keys` to add the passport signing key and demo API keys.
APP_ENV=dev
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/titlivo
PUBLIC_API_BASE=http://localhost:8000
PUBLIC_WEB_BASE=http://localhost:5173
ISSUER_DID=did:web:localhost%3A8000
CORS_ORIGINS=http://localhost:5173
# Added by `make keys` (never commit real values):
# PASSPORT_SIGNING_JWK='{"kty":"OKP","crv":"Ed25519","x":"…","d":"…"}'
# DEMO_API_KEY=tlv_live_…
# ADMIN_API_KEY=tlv_admin_…
# Optional: Gemini key from GCP project titlivodev (restricted to the Generative Language API)
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_MODE=live
